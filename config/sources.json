        "metricKey": "job_vacancy_rate",
        "metricLabel": "Job vacancy rate",
        "unit": "%",
        "geography": "Germany",
        "seriesDimension": "nace_r2_1",
        "timeDimension": "time",
        "maxSeries": 40,
        "bootstrapQuery": {
          "lang": "EN",
          "geo": "DE",
          "freq": "Q",
          "indic_em": "JOBRATE",
          "sizeclas": "TOTAL",
          "s_adj": "NSA",
          "lastTimePeriod": "12"
        },
        "incrementalQuery": {
          "lang": "EN",
          "geo": "DE",
          "freq": "Q",
          "indic_em": "JOBRATE",
          "sizeclas": "TOTAL",
          "s_adj": "NSA",
          "lastTimePeriod": "4"
        }
      }
