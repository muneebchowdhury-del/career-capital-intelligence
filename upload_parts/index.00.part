<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Capital Flow → Career Capital Intelligence v5 Zero-Cost</title>
<style>
:root{--bg:#071018;--panel:#0d1823;--line:#233547;--text:#ecf4fb;--muted:#91a4b7;--cyan:#46d9ff;--green:#6ce5a1;--amber:#ffce66;--red:#ff7b86;--violet:#aa8cff;--shadow:0 12px 35px rgba(0,0,0,.26)}*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#061019,#09131e 55%,#08111a);color:var(--text);font:14px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}a{color:var(--cyan);text-decoration:none}a:hover{text-decoration:underline}.wrap{max-width:1640px;margin:auto;padding:24px}.hero,.controls,.topGrid,.sectionGrid{display:grid;gap:18px;margin-bottom:18px}.hero{grid-template-columns:1.45fr .8fr}.controls{grid-template-columns:1.12fr .88fr}.topGrid{grid-template-columns:1.12fr .88fr}.sectionGrid{grid-template-columns:1fr 1fr}.heroCard,.panel{background:rgba(13,24,35,.93);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)}.heroCard,.panel{padding:18px}.heroCard{padding:26px}.kicker{color:var(--cyan);text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:800}.hero h1{font-size:32px;line-height:1.08;margin:8px 0 10px}.hero p,.sub{color:var(--muted)}.sub{font-size:12px}.stamp,.tagList{display:flex;gap:7px;flex-wrap:wrap}.stamp{margin-top:18px}.chip,.tag{border:1px solid #2d4358;background:#0a1621;padding:6px 9px;border-radius:999px;color:#bdd0e2;font-size:11px}.heroMeta .metric{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #1b2d3d}.heroMeta .metric:last-child{border:0}.heroMeta b{font-size:16px}.panel h2,.panel h3{margin:0 0 10px}.controlGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.controlGrid label,.sliderRow label,.profileRow label{font-size:12px;color:#b7c6d5}.controlGrid select,.controlGrid input,.controlGrid button,.profileRow select{width:100%;background:#09141f;border:1px solid #2a3d50;color:var(--text);padding:9px 10px;border-radius:10px}.controlGrid button{cursor:pointer;font-weight:700}.weightGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 16px}.sliderRow{display:grid;grid-template-columns:1fr 100px 34px;align-items:center;gap:8px}.sliderRow input[type=range]{width:100%}.sliderRow output{text-align:right;color:var(--cyan)}.profileGrid{display:grid;gap:7px}.profileRow{display:grid;grid-template-columns:24px 1fr minmax(100px,1.4fr) 42px 90px;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid #162838}.profileRow input[type=range]{width:100%}.profileRow output{color:var(--cyan);text-align:right}.profileRow.inactive{opacity:.48}.warn,.risk,.info{padding:10px 12px;border-radius:8px}.warn{border-left:3px solid var(--amber);background:#171b19}.risk{border-left:3px solid var(--red);background:#1a1419}.info{border-left:3px solid var(--cyan);background:#101c25}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.rankCard{background:#0a1621;border:1px solid #23384b;border-radius:14px;padding:13px;cursor:pointer;transition:.15s}.rankCard:hover{transform:translateY(-2px);border-color:#3e6888}.rankTop{display:flex;justify-content:space-between;align-items:center}.rankNum{font-size:11px;color:var(--muted)}.score{font-size:24px;font-weight:800;color:var(--green)}.range{font-size:10px;color:var(--muted)}.rankCard h4{font-size:13px;margin:8px 0 4px}.rankCard p{margin:0;color:var(--muted);font-size:11px}.bar{height:7px;background:#152536;border-radius:999px;overflow:hidden;margin-top:10px}.bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--green));border-radius:999px}.chartTools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px}.chartTools select{background:#09141f;border:1px solid #2a3d50;color:var(--text);border-radius:8px;padding:7px}.chart{width:100%;height:300px;background:#09131e;border:1px solid #1f3345;border-radius:12px}.axisLabel{fill:#8ea2b6;font-size:10px}.gridline{stroke:#193044;stroke-width:1}.dot{cursor:pointer}.dotLabel{fill:#dce9f5;font-size:9px;pointer-events:none}.capitalBars,.robustList,.rawList{display:grid;gap:8px}.capRow{display:grid;grid-template-columns:210px 1fr 42px;gap:8px;align-items:center}.capRow b{font-size:11px}.capRow .bar{margin:0}.capRow span{font-size:11px;color:var(--muted);text-align:right}.robRow{display:grid;grid-template-columns:1.5fr 72px 78px 100px;gap:8px;padding:8px;border:1px solid #203649;border-radius:10px;background:#0a1722;align-items:center}.robRow b{font-size:11px}.robRow span{font-size:11px;text-align:right}.rawRow{display:grid;grid-template-columns:1.4fr .65fr .8fr .7fr;gap:8px;padding:8px;border:1px solid #203649;border-radius:10px;background:#0a1722}.rawRow b{font-size:11px}.rawRow span{font-size:10px;color:var(--muted)}.tablePanel{padding:0;overflow:hidden;margin-bottom:18px}.tableHead{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid var(--line)}.tableScroll{overflow:auto;max-height:650px}table{border-collapse:collapse;width:100%;min-width:1550px}th,td{padding:9px;border-bottom:1px solid #162839;text-align:left}th{position:sticky;top:0;background:#0e1b27;color:#b7c7d8;font-size:11px;z-index:3;cursor:pointer;white-space:nowrap}td{font-size:12px}tbody tr{cursor:pointer}tbody tr:hover{background:#0b1a27}.nameCell{min-width:280px}.nameCell b{display:block;font-size:13px}.nameCell span{color:var(--muted);font-size:11px}.n{text-align:right;font-variant-numeric:tabular-nums}.heat{font-weight:700}.high{color:var(--green)}.med{color:var(--amber)}.low{color:var(--red)}.drawer{position:fixed;inset:0;display:none;background:rgba(1,7,12,.68);z-index:20}.drawer.on{display:block}.drawerPane{position:absolute;right:0;top:0;bottom:0;width:min(820px,96vw);background:#09151f;border-left:1px solid #2a3c4d;overflow:auto;padding:24px}.drawerClose{position:sticky;top:0;float:right;background:#0e1c29;color:#fff;border:1px solid #355069;border-radius:10px;padding:8px 12px;cursor:pointer;z-index:2}.drawer h2{font-size:26px;margin:10px 0 4px}.drawer h3{margin:22px 0 8px}.drawer p{color:#b9cad9}.scoreGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.scoreTile{background:#0d1d2a;border:1px solid #23384b;border-radius:12px;padding:10px}.scoreTile span{display:block;color:var(--muted);font-size:10px}.scoreTile b{font-size:19px}.path{border-left:2px solid #27475f;margin-left:8px;padding-left:16px}.step{margin:0 0 16px;position:relative}.step:before{content:"";position:absolute;width:9px;height:9px;border-radius:50%;background:var(--cyan);left:-21px;top:5px}.step b{display:block}.srcList{display:grid;gap:8px}.src{padding:10px;border:1px solid #22384a;border-radius:10px;background:#0a1722}.src small{display:block;color:var(--muted)}.footerNote{color:var(--muted);font-size:11px;margin:12px 2px 26px}.tier{font-size:10px;border:1px solid #2b4357;border-radius:999px;padding:3px 7px;color:#c8d8e6}.driverGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.driver{background:#0a1722;border:1px solid #203649;border-radius:9px;padding:7px}.driver span{font-size:10px;color:var(--muted);display:block}.driver b{font-size:13px}.positive{color:var(--green)}.negative{color:var(--red)}.neutral{color:var(--muted)}
@media(max-width:1100px){.hero,.controls,.topGrid,.sectionGrid{grid-template-columns:1fr}.cards{grid-template-columns:repeat(2,1fr)}.controlGrid{grid-template-columns:1fr 1fr}.scoreGrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.wrap{padding:12px}.hero h1{font-size:26px}.cards,.controlGrid,.weightGrid{grid-template-columns:1fr}.profileRow{grid-template-columns:24px 1fr 1fr 38px}.profileRow select{grid-column:2/5}.rawRow,.robRow{grid-template-columns:1fr 1fr}.driverGrid{grid-template-columns:1fr 1fr}}
</style></head><body><div class="wrap">
<section class="hero"><div class="heroCard"><div class="kicker">Capital Flow → Career Capital Intelligence · v5 Zero-Cost</div><h1>Where is money flowing — and where should expertise compound?</h1><p>A thesis-driven decision system linking raw capital evidence to structural opportunity, specialization scarcity, geography, time horizon, AI resilience and realistic paths to value capture.</p><div class="stamp"><span class="chip" id="evidenceUpdatedChip">Evidence: loading…</span><span class="chip" id="syncStatusChip">Data: loading…</span><span class="chip" id="nodeCountChip">Opportunity nodes: —</span><span class="chip" id="sourceCountChip">Evidence sources: —</span><span class="chip" id="versionChip">Version: —</span><span class="chip">Confidence ≠ certainty</span><span class="chip">Raw flows kept type-separated</span></div></div><div class="heroCard heroMeta"><h3>Verified evidence anchors</h3><div id="heroMetrics"><div class="sub">Loading live evidence anchors…</div></div></div></section>
<section class="controls"><div class="panel"><h2>Decision controls</h2><div class="sub">Objective, geography, horizon and scenarios change the ranking. Scenario effects are driven by underlying forces rather than hand-edited node points.</div><div class="controlGrid" style="margin-top:12px"><label>Ranking objective<select id="objective"><option value="overall">Overall Opportunity</option><option value="market">Market Attractiveness</option><option value="career">Career Attractiveness</option><option value="fit">Personal Strategic Fit</option><option value="wealth">Wealth Creation</option><option value="resilience">AI Resilience</option><option value="asymmetry">Asymmetric Opportunity</option></select></label><label>Scenario<select id="scenario"><option value="baseline">Baseline</option><option value="aiCooling">AI Capex Cooling</option><option value="powerBottleneck">Power Bottleneck</option><option value="geoFragment">Geopolitical Fragmentation</option><option value="agentBoom">Agentic Enterprise Boom</option><option value="biotechBreak">Biotech Breakthrough</option></select></label><label>Time horizon<select id="horizon"><option value="1-2y">Now / 1–2 years</option><option value="3-5y">3–5 years</option><option value="5-10y" selected>5–10 years</option><option value="10-15y">10–15 years</option></select></label><label>Geography<select id="geo"><option>Global</option><option>US</option><option>Europe</option><option>Germany</option></select></label><label>Sector<select id="sector"><option value="all">All sectors</option></select></label><label>Search<input id="search" type="search" placeholder="AI security, grid, robotics…"></label><label>Actions<button id="reset">Reset weights + profile</button></label></div><h3 style="margin-top:18px">Opportunity-score weights</h3><div class="weightGrid" id="weights"></div></div>
<div class="panel"><h2>Personal-fit profile</h2><div class="sub">Neutral now truly means neutral. Activate only dimensions you care about; inactive dimensions contribute nothing.</div><div class="profileGrid" id="profile" style="margin-top:12px"></div><div class="info" style="margin-top:12px"><b>Personal Fit:</b> with no active preferences it equals Career Attractiveness. Each active dimension has both a desired intensity and an importance weight.</div></div></section>
<section class="sectionGrid"><div class="panel"><h2>Scenario drivers</h2><div class="sub" id="scenarioNote">Baseline has no driver shock.</div><div class="driverGrid" id="driverGrid" style="margin-top:12px"></div></div><div class="panel"><h2>Rank robustness</h2><div class="sub">500 simulations perturb evidence scores by calculated uncertainty; Overall Opportunity also perturbs your weights ±20%.</div><div class="robustList" id="robustList" style="margin-top:12px"></div></div></section>
<section class="topGrid"><div class="panel"><h2>Top opportunities</h2><div class="sub" id="topCaption"></div><div class="cards" id="topCards" style="margin-top:12px"></div></div><div class="panel"><h2>Opportunity quadrant</h2><div class="chartTools"><label>X <select id="xMetric"></select></label><label>Y <select id="yMetric"></select></label></div><svg class="chart" id="scatter" viewBox="0 0 620 300" preserveAspectRatio="none"></svg></div></section>
