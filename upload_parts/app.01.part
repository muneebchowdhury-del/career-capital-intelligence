isk'),true)}">${s(n,'crowdingRisk').toFixed(0)}</td><td class="n heat ${heat(s(n,'hypeRisk'),true)}">${s(n,'hypeRisk').toFixed(0)}</td><td class="n">${s(n,'confidence').toFixed(0)} ±${uncertainty(n).toFixed(1)}</td>`;tr.onclick=()=>openDrawer(x);tbody.appendChild(tr)})}
const metricOptions=['score','market','career','fit','capital','momentum','durability','scarcity','income','aiResilience','businessValue','entrepreneurship','accessibility','valueCapture','transferability','optionality','capitalQuality','defensibility','proofability','crowdingRisk','hypeRisk','confidence'];
function metricValue(x,k){if(k==='score')return x.score;if(k==='market')return x.market;if(k==='career')return x.career;if(k==='fit')return x.fit;return s(x.n,k)}
function renderScatter(list){const xk=xMetric.value,yk=yMetric.value,svg=scatter;svg.textContent='';const W=620,H=300,p=38;for(let t=0;t<=100;t+=20){let x=p+(W-2*p)*t/100,y=H-p-(H-2*p)*t/100;svg.insertAdjacentHTML('beforeend',`<line class="gridline" x1="${x}" y1="${p}" x2="${x}" y2="${H-p}"/><line class="gridline" x1="${p}" y1="${y}" x2="${W-p}" y2="${y}"/><text class="axisLabel" x="${x-7}" y="${H-12}">${t}</text><text class="axisLabel" x="6" y="${y+3}">${t}</text>`)}list.forEach(x=>{let xv=metricValue(x,xk),yv=metricValue(x,yk),cx=p+(W-2*p)*xv/100,cy=H-p-(H-2*p)*yv/100,r=5+7*s(x.n,'capital')/100,g=document.createElementNS('http://www.w3.org/2000/svg','g');const circle=document.createElementNS('http://www.w3.org/2000/svg','circle');circle.setAttribute('class','dot');circle.setAttribute('cx',cx);circle.setAttribute('cy',cy);circle.setAttribute('r',r);circle.setAttribute('fill','rgba(70,217,255,.65)');circle.setAttribute('stroke','#b8efff');const text=document.createElementNS('http://www.w3.org/2000/svg','text');text.setAttribute('class','dotLabel');text.setAttribute('x',cx+r+3);text.setAttribute('y',cy+3);text.textContent=x.n.name.split(' ').slice(0,3).join(' ');g.append(circle,text);g.onclick=()=>openDrawer(x);svg.appendChild(g)})}
function rawHtml(n){if(!(n.capitalObservations||[]).length)return'<div class="sub">No comparable raw time series yet; evidence anchors remain available below.</div>';return n.capitalObservations.map(o=>`<div class="rawRow"><b>${esc(o.series)}${o.proxy?' · proxy':''}</b><span>${esc(o.period)}<br>${esc(o.status)}</span><b>${Number(o.value).toLocaleString(undefined,{maximumFractionDigits:2})} ${esc(o.unit)}</b><span>${esc(o.flowType)}<br>${esc(o.source)}</span></div>`).join('')}
function openDrawer(x){let n=x.n,src=n.sources.map(id=>DB.sources.find(s=>s.id===id)).filter(Boolean),cb=n.confidenceBreakdown||{};drawerContent.innerHTML=`<div class="kicker">${esc(n.sector)}</div><h2>${esc(n.name)}</h2><p>${esc(n.thesis)}</p><div class="scoreGrid">${[['Selected',x.score],['Market',x.market],['Career',x.career],['Personal fit',x.fit],['Top-5 probability',x.rob.top5],['Median rank',x.rob.median],['Confidence',s(n,'confidence')],['Uncertainty ±',uncertainty(n)]].map(([a,b])=>`<div class="scoreTile"><span>${esc(a)}</span><b>${typeof b==='number'?b.toFixed(a==='Uncertainty ±'?1:0):esc(b)}${a==='Top-5 probability'?'%':''}</b></div>`).join('')}</div><h3>Context</h3><p><b>Geography:</b> ${esc(geo.value)} → ${esc(geoQual(n))} (${geoScore(n)}/100) · <b>Horizon:</b> ${esc(DB.horizonLabels[horizon.value])} → ${horizonScore(n)}/100 · <b>Scenario impact:</b> ${driverImpact(n).toFixed(1)}</p><p><b>Value-chain position:</b> ${esc(n.hierarchy?.valueChainPosition||'—')}</p><h3>Evidence anchor</h3><p>${esc(n.evidence)}</p><h3>Raw capital / activity observations</h3><div class="rawList">${rawHtml(n)}</div><h3>Confidence breakdown</h3><div class="scoreGrid">${[['Source quality',cb.sourceQuality],['Source count',cb.sourceCount],['Source diversity',cb.sourceDiversity],['Recency',cb.recency],['Evidence directness',cb.directness],['Calculated confidence',cb.calculatedConfidence]].map(([a,b])=>`<div class="scoreTile"><span>${esc(a)}</span><b>${Number.isFinite(Number(b))?Number(b):'—'}</b></div>`).join('')}</div><h3>Expertise stack</h3><div class="tagList">${n.skills.map(z=>`<span class="tag">${esc(z)}</span>`).join('')}</div><h3>Tools / technologies</h3><div class="tagList">${n.tools.map(z=>`<span class="tag">${esc(z)}</span>`).join('')}</div><h3>Career path</h3><div class="path">${n.path.map(([a,b])=>`<div class="step"><b>${esc(a)}</b><span>${esc(b)}</span></div>`).join('')}</div><h3>Target roles</h3><div class="tagList">${n.roles.map(z=>`<span class="tag">${esc(z)}</span>`).join('')}</div><h3>Counter-thesis</h3><div class="risk">${esc(n.counter)}</div><h3>What would change my mind?</h3><div class="warn">${esc(n.changeMind)}</div><h3>Sources used for this node</h3><div class="srcList">${src.map(z=>`<div class="src"><a href="${esc(safeUrl(z.url))}" target="_blank" rel="noopener noreferrer"><b>${esc(z.id)} · ${esc(z.name)}</b></a><small>${esc(z.date)} · ${esc(z.category)} · quality ${Number(z.qualityScore)}/100<br>${esc(z.note)}</small></div>`).join('')}</div>`;drawer.classList.add('on')}
function renderSources(){sourcesEl.innerHTML=DB.sources.map(z=>`<div class="src"><a href="${esc(safeUrl(z.url))}" target="_blank" rel="noopener noreferrer"><b>${esc(z.id)} · ${esc(z.name)}</b></a><small>${esc(z.date)} · ${esc(z.category||'Research')} · quality ${Number(z.qualityScore)||'—'}/100<br>${esc(z.note)}</small></div>`).join('')}
function renderAll(){robustCache.clear();let list=scored();renderDrivers();renderTop(list);renderRobust(list);renderBars(list);renderRaw(list);renderTable(list);renderScatter(list)}
function exportCSV(){let list=scored(),cols=['rank','name','sector','selected_score','market','career','personal_fit','top5_probability','median_rank','rank_p10','rank_p90','geography','geo_score','horizon','horizon_score','confidence','uncertainty_points','capital','capital_quality','momentum','durability','scarcity','income','ai_resilience','value_capture','entrepreneurship','defensibility','accessibility','proof_access','crowding_risk','hype_risk'];let rows=[cols.join(',')];list.forEach((x,i)=>rows.push([i+1,`"${x.n.name.replaceAll('"','""')}"`,`"${x.n.sector.replaceAll('"','""')}"`,x.score.toFixed(1),x.market.toFixed(1),x.career.toFixed(1),x.fit.toFixed(1),x.rob.top5.toFixed(1),x.rob.median,x.rob.p10,x.rob.p90,geo.value,geoScore(x.n),horizon.value,horizonScore(x.n),s(x.n,'confidence'),uncertainty(x.n),s(x.n,'capital'),s(x.n,'capitalQuality'),s(x.n,'momentum'),s(x.n,'durability'),s(x.n,'scarcity'),s(x.n,'income'),s(x.n,'aiResilience'),s(x.n,'valueCapture'),s(x.n,'entrepreneurship'),s(x.n,'defensibility'),s(x.n,'accessibility'),s(x.n,'proofability'),s(x.n,'crowdingRisk'),s(x.n,'hypeRisk')].join(',')));let blob=new Blob([rows.join('\n')],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='capital_career_rankings_v4_1.csv';a.click();URL.revokeObjectURL(a.href)}
const objective=document.getElementById('objective'),scenario=document.getElementById('scenario'),horizon=document.getElementById('horizon'),geo=document.getElementById('geo'),sector=document.getElementById('sector'),search=document.getElementById('search'),weightsEl=document.getElementById('weights'),profileEl=document.getElementById('profile'),topCards=document.getElementById('topCards'),topCaption=document.getElementById('topCaption'),tbody=document.getElementById('tbody'),capitalBars=document.getElementById('capitalBars'),rawList=document.getElementById('rawList'),robustList=document.getElementById('robustList'),driverGrid=document.getElementById('driverGrid'),scenarioNote=document.getElementById('scenarioNote'),scatter=document.getElementById('scatter'),xMetric=document.getElementById('xMetric'),yMetric=document.getElementById('yMetric'),drawer=document.getElementById('drawer'),drawerContent=document.getElementById('drawerContent'),sourcesEl=document.getElementById('sources');
[...new Set(DB.nodes.map(n=>n.sector))].sort().forEach(z=>{const o=document.createElement('option');o.value=z;o.textContent=z;sector.appendChild(o)});metricOptions.forEach(k=>{for(const sel of [xMetric,yMetric]){const o=document.createElement('option');o.value=k;o.textContent=labels[k]||k;sel.appendChild(o)}});xMetric.value='scarcity';yMetric.value='capital';
[objective,scenario,horizon,geo,sector,xMetric,yMetric].forEach(e=>e.onchange=()=>{robustCache.clear();renderAll()});search.oninput=()=>{robustCache.clear();renderAll()};document.getElementById('reset').onclick=()=>{weights={...DB.methodology.defaultWeights};Object.keys(profile).forEach(k=>profile[k]={value:50,active:false,importance:2});renderWeights();renderProfile();robustCache.clear();renderAll()};document.getElementById('export').onclick=exportCSV;document.getElementById('closeDrawer').onclick=()=>drawer.classList.remove('on');drawer.onclick=e=>{if(e.target===drawer)drawer.classList.remove('on')};document.querySelectorAll('th[data-sort]').forEach(th=>th.onclick=()=>{let k=th.dataset.sort;if(sortKey===k)sortDir*=-1;else{sortKey=k;sortDir=k==='name'?1:-1}renderAll()});renderWeights();renderProfile();renderSources();renderAll();
};
