ialization":"Defense AI, Drones & Autonomous Systems"}},{"id":"robotics","name":"Robotics & Industrial Automation","sector":"Robotics / Manufacturing","thesis":"AI moves from digital work into the physical economy. The moat comes from integrating perception, controls, hardware, safety and real operations.","evidence":"542k industrial robots were installed globally in 2024—more than double a decade earlier; US installations rose 11% in 2025.","sources":["S9","S10","S17"],"scores":{"capital":77,"momentum":82,"durability":96,"scarcity":91,"income":95,"aiResilience":99,"businessValue":98,"entrepreneurship":89,"defensibility":94,"accessibility":44,"valueCapture":94,"transferability":87,"optionality":93,"hypeRisk":43,"confidence":85,"capitalQuality":91,"crowdingRisk":57,"proofability":72},"chars":{"techDepth":95,"business":51,"math":83,"hardware":93,"regulation":46,"longTraining":87,"entrepreneurship":78},"meta":{"timeToEntry":"3–5y","difficulty":"Very high","ceiling":"Exceptional","ownership":"Very high","entry":"Mechatronics/CS/controls + ML","signal":"Structural","horizon":"5–15y"},"skills":["controls","robot perception","SLAM","planning","embedded systems","safety","industrial integration","simulation"],"tools":["C++","Python","ROS2","Gazebo/Isaac Sim concepts","PyTorch","OpenCV","real-time systems","PLC/industrial protocols","CAD basics"],"path":[["Foundation","Build mechanics/controls/programming and probability/linear algebra foundations."],["Practitioner","Create a real or simulated robot stack: perception → planning → control."],["Specialist","Own a hard layer such as perception, manipulation, autonomy, safety or factory integration."],["Leverage","Lead robotics platforms, industrial automation programs, product companies or specialist integration businesses."]],"roles":["Robotics Engineer","Controls Engineer","Perception/SLAM Engineer","Autonomy Architect","Robotics Product/Founder"],"counter":"Hardware cycles are slow, unit economics can be difficult and humano