window.startCapitalDashboard = function(DB){
const positiveDims=['capital','capitalQuality','momentum','durability','scarcity','income','aiResilience','businessValue','entrepreneurship','defensibility','accessibility','proofability','valueCapture','transferability','optionality'];
const labels={capital:'Capital flow',momentum:'Momentum',durability:'Durability',scarcity:'Talent scarcity',income:'Income potential',aiResilience:'AI resilience',businessValue:'Business value',entrepreneurship:'Entrepreneurship',accessibility:'Accessibility',valueCapture:'Value capture',transferability:'Transferability',optionality:'Option value',capitalQuality:'Capital quality',proofability:'Proof accessibility',crowdingRisk:'Crowding penalty',hypeRisk:'Hype penalty',confidence:'Confidence',score:'Selected score',market:'Market attractiveness',career:'Career attractiveness',fit:'Personal fit'};
const profileLabels={techDepth:'Technical depth',business:'Business/commercial',math:'Math intensity',hardware:'Hardware/physical',regulation:'Regulation/domain',longTraining:'Long-training tolerance',entrepreneurship:'Entrepreneurial ambition'};
let weights={...DB.methodology.defaultWeights};
let profile={};Object.keys(profileLabels).forEach(k=>profile[k]={value:50,active:false,importance:2});
let sortKey='score',sortDir=-1,robustCache=new Map();
const clamp=x=>Math.max(0,Math.min(100,x));
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safeUrl=x=>{try{const u=new URL(String(x));return u.protocol==='https:'?u.toString():'#'}catch{return '#'}};
function driverImpact(n){const d=DB.scenarioDrivers[scenario.value]||{};const e=n.driverExposure||{};let sum=0,abs=0;for(const [k,v] of Object.entries(e)){sum+=(d[k]||0)*v;abs+=Math.abs(v)}return abs?sum/Math.max(1,abs):0}
function s(n,k){let v=n.scores[k]??0;const imp=driverImpact(n);if(k==='momentum')v+=imp*.42;if(k==='capital')v+=imp*.20;if(k==='businessValue')v+=imp*.10;if(k==='durability')v+=imp*.05;return clamp(v)}
function weightedOverall(n,w=weights){let num=0,den=0;for(const k of positiveDims){const ww=+w[k]||0;num+=s(n,k)*ww;den+=ww}let base=den?num/den:0;return clamp(base-s(n,'hypeRisk')*(+w.hypeRisk||0)/100-s(n,'crowdingRisk')*(+w.crowdingRisk||0)/100)}
function market(n){const v={capital:15,capitalQuality:10,momentum:13,durability:17,businessValue:13,defensibility:10,valueCapture:9,entrepreneurship:6,confidence:7};let a=0,b=0;for(const[k,w]of Object.entries(v)){a+=s(n,k)*w;b+=w}return clamp(a/b-s(n,'hypeRisk')*.07-s(n,'crowdingRisk')*.04)}
function career(n){const v={income:16,scarcity:16,aiResilience:14,businessValue:11,transferability:9,optionality:9,accessibility:7,proofability:6,valueCapture:5,durability:5,defensibility:2};let a=0,b=0;for(const[k,w]of Object.entries(v)){a+=s(n,k)*w;b+=w}return clamp(a/b-s(n,'crowdingRisk')*.05)}
function profileMatch(n){let num=0,den=0;for(const[k,p]of Object.entries(profile)){if(!p.active)continue;const imp=+p.importance||1;num+=(100-Math.abs((n.chars[k]??50)-p.value))*imp;den+=imp}return den?num/den:null}
function fit(n){const pm=profileMatch(n);return pm===null?career(n):.65*career(n)+.35*pm}
function wealth(n){return clamp(.27*s(n,'valueCapture')+.24*s(n,'entrepreneurship')+.18*s(n,'businessValue')+.12*s(n,'durability')+.10*s(n,'income')+.09*s(n,'defensibility')-.08*s(n,'hypeRisk'))}
function asym(n){return clamp(.20*s(n,'durability')+.15*s(n,'scarcity')+.14*s(n,'businessValue')+.12*s(n,'valueCapture')+.11*s(n,'momentum')+.08*s(n,'capitalQuality')+.08*s(n,'accessibility')+.06*s(n,'proofability')+.06*s(n,'entrepreneurship')-.12*s(n,'hypeRisk')-.10*s(n,'crowdingRisk'))}
function objectiveBase(n,w=weights){switch(objective.value){case'market':return market(n);case'career':return career(n);case'fit':return fit(n);case'wealth':return wealth(n);case'resilience':return s(n,'aiResilience');case'asymmetry':return asym(n);default:return weightedOverall(n,w)}}
function geoScore(n){return n.geoScores?.[geo.value]??n.geoScores?.Global??75}function horizonScore(n){return n.horizonScores?.[horizon.value]??90}
function contextScore(n,w=weights){const base=objectiveBase(n,w);return clamp(.75*base+.15*horizonScore(n)+.10*geoScore(n))}
function geoQual(n){return n.geo?.[geo.value]||n.geo?.Global||'Relevant'}
function uncertainty(n){return n.uncertaintyPoints||5}
function tier(score,top){const d=top-score;if(d<=2.5)return'Top cluster';if(d<=6)return'Strong';if(d<=11)return'Watchlist';return'Longer-shot'}
function filtered(){const q=search.value.toLowerCase().trim(),sec=sector.value;return DB.nodes.filter(n=>(sec==='all'||n.sector===sec)&&(!q||(n.name+' '+n.sector+' '+n.thesis+' '+n.skills.join(' ')).toLowerCase().includes(q)))}
function randFactory(seed){let x=seed>>>0;return()=>{x=(1664525*x+1013904223)>>>0;return x/4294967296}}
function normal(r){let u=0,v=0;while(!u)u=r();while(!v)v=r();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v)}
function robustness(nodes){const key=[objective.value,scenario.value,horizon.value,geo.value,JSON.stringify(weights),JSON.stringify(profile),nodes.map(n=>n.id).join('|')].join('::');if(robustCache.has(key))return robustCache.get(key);const stats={};nodes.forEach(n=>stats[n.id]={ranks:[],top5:0});const R=500,r=randFactory(19790723);for(let z=0;z<R;z++){let w={...weights};if(objective.value==='overall'){for(const k of Object.keys(w)){w[k]=w[k]*(.8+.4*r())}}let vals=nodes.map(n=>[n,clamp(contextScore(n,w)+normal(r)*uncertainty(n))]).sort((a,b)=>b[1]-a[1]);vals.forEach((x,i)=>{stats[x[0].id].ranks.push(i+1);if(i<5)stats[x[0].id].top5++})}for(const n of nodes){let a=stats[n.id].ranks.sort((a,b)=>a-b);const q=p=>a[Math.min(a.length-1,Math.floor((a.length-1)*p))];stats[n.id]={top5:stats[n.id].top5/R*100,median:q(.5),p10:q(.1),p90:q(.9)}}robustCache.set(key,stats);return stats}
function scored(){const nodes=filtered(),rob=robustness(nodes);let a=nodes.map(n=>({n,score:contextScore(n),market:market(n),career:career(n),fit:fit(n),match:profileMatch(n),rob:rob[n.id]}));if(sortKey==='name')a.sort((A,B)=>sortDir*A.n.name.localeCompare(B.n.name));else a.sort((A,B)=>sortDir*(valueForSort(A,sortKey)-valueForSort(B,sortKey)));return a}
function valueForSort(x,k){if(k==='score')return x.score;if(k==='market')return x.market;if(k==='career')return x.career;if(k==='fit')return x.fit;if(k==='top5')return x.rob?.top5||0;if(k==='rank')return-x.score;if(k==='name')return 0;return s(x.n,k)}
function heat(v,rev=false){let z=rev?100-v:v;return z>=85?'high':z>=65?'med':'low'}
function renderWeights(){weightsEl.textContent='';Object.keys(DB.methodology.defaultWeights).forEach(k=>{let d=document.createElement('div');d.className='sliderRow';d.innerHTML=`<label>${esc(labels[k]||k)}</label><input type="range" min="0" max="20" step="1" value="${Number(weights[k])}" data-w="${esc(k)}"><output>${Number(weights[k])}</output>`;weightsEl.appendChild(d)});weightsEl.querySelectorAll('input').forEach(i=>i.oninput=e=>{weights[e.target.dataset.w]=+e.target.value;e.target.nextElementSibling.value=e.target.value;robustCache.clear();renderAll()})}
function renderProfile(){profileEl.textContent='';Object.keys(profile).forEach(k=>{let p=profile[k],d=document.createElement('div');d.className='profileRow'+(p.active?'':' inactive');d.innerHTML=`<input type="checkbox" ${p.active?'checked':''} data-a="${esc(k)}" title="Use this preference"><label>${esc(profileLabels[k])}</label><input type="range" min="0" max="100" step="5" value="${Number(p.value)}" data-p="${esc(k)}" ${p.active?'':'disabled'}><output>${Number(p.value)}</output><select data-i="${esc(k)}" ${p.active?'':'disabled'}><option value="1" ${p.importance==1?'selected':''}>Low</option><option value="2" ${p.importance==2?'selected':''}>Medium</option><option value="3" ${p.importance==3?'selected':''}>High</option></select>`;profileEl.appendChild(d)});profileEl.querySelectorAll('input[type=checkbox]').forEach(i=>i.onchange=e=>{profile[e.target.dataset.a].active=e.target.checked;robustCache.clear();renderProfile();renderAll()});profileEl.querySelectorAll('input[type=range]').forEach(i=>i.oninput=e=>{profile[e.target.dataset.p].value=+e.target.value;e.target.nextElementSibling.value=e.target.value;robustCache.clear();renderAll()});profileEl.querySelectorAll('select').forEach(i=>i.onchange=e=>{profile[e.target.dataset.i].importance=+e.target.value;robustCache.clear();renderAll()})}
function renderDrivers(){const d=DB.scenarioDrivers[scenario.value]||{};driverGrid.textContent='';for(const[k,label]of Object.entries(DB.driverLabels)){const v=Number(d[k]||0),c=v>0?'positive':v<0?'negative':'neutral';driverGrid.insertAdjacentHTML('beforeend',`<div class="driver"><span>${esc(label)}</span><b class="${c}">${v>0?'+':''}${v}</b></div>`)}scenarioNote.textContent=scenario.value==='baseline'?'Baseline has no driver shock.':'Each node responds according to its explicit exposure to these drivers.'}
function renderTop(list){topCards.textContent='';if(!list.length)return;const top=list[0].score;topCaption.textContent=`${objective.options[objective.selectedIndex].text} · ${scenario.options[scenario.selectedIndex].text} · ${DB.horizonLabels[horizon.value]} · ${geo.value}`;list.slice(0,6).forEach((x,i)=>{let c=document.createElement('div');c.className='rankCard';c.innerHTML=`<div class="rankTop"><span class="rankNum">#${i+1} · ${esc(tier(x.score,top))}</span><span class="score">${x.score.toFixed(0)}</span></div><div class="range">±${uncertainty(x.n).toFixed(1)} pts evidence uncertainty · Top-5 ${x.rob.top5.toFixed(0)}%</div><h4>${esc(x.n.name)}</h4><p>${esc(geoQual(x.n))} · ${esc(DB.horizonLabels[horizon.value])} · ${esc(x.n.meta?.ceiling||'—')} ceiling</p><div class="bar"><i style="width:${clamp(x.score)}%"></i></div>`;c.onclick=()=>openDrawer(x);topCards.appendChild(c)})}
function renderBars(list){capitalBars.textContent='';[...list].sort((a,b)=>s(b.n,'capital')-s(a.n,'capital')).slice(0,10).forEach(x=>{let v=s(x.n,'capital');capitalBars.insertAdjacentHTML('beforeend',`<div class="capRow"><b>${esc(x.n.name)}</b><div class="bar"><i style="width:${v}%"></i></div><span>${v.toFixed(0)}</span></div>`)})}
function renderRobust(list){robustList.textContent='';[...list].sort((a,b)=>b.rob.top5-a.rob.top5).slice(0,7).forEach(x=>robustList.insertAdjacentHTML('beforeend',`<div class="robRow"><b>${esc(x.n.name)}</b><span>Top-5 <b>${x.rob.top5.toFixed(0)}%</b></span><span>Median <b>#${x.rob.median}</b></span><span>80% ranks <b>${x.rob.p10}–${x.rob.p90}</b></span></div>`))}
function renderRaw(list){rawList.textContent='';let obs=[];for(const x of list){for(const o of x.n.capitalObservations||[])obs.push({n:x.n,o})}obs=obs.slice(0,14);if(!obs.length){rawList.innerHTML='<div class="sub">No raw observation series for the current filter.</div>';return}obs.forEach(({n,o})=>rawList.insertAdjacentHTML('beforeend',`<div class="rawRow"><b>${esc(n.name)}<br><span>${esc(o.series)}${o.proxy?' · proxy':''}</span></b><span>${esc(o.period)}<br>${esc(o.status)}</span><b>${Number(o.value).toLocaleString(undefined,{maximumFractionDigits:2})} ${esc(o.unit)}</b><span>${esc(o.flowType)}<br>${esc(o.source)}</span></div>`))}
function renderTable(list){tbody.textContent='';list.forEach((x,i)=>{let n=x.n,tr=document.createElement('tr');tr.innerHTML=`<td class="n">${i+1}</td><td class="nameCell"><b>${esc(n.name)}</b><span>${esc(n.hierarchy?.valueChainPosition||'—')} · ${esc(geoQual(n))} · ${esc(DB.horizonLabels[horizon.value])}</span></td><td class="n heat ${heat(x.score)}">${x.score.toFixed(1)}</td><td class="n">${x.market.toFixed(1)}</td><td class="n">${x.career.toFixed(1)}</td><td class="n">${x.fit.toFixed(1)}</td><td class="n heat ${heat(x.rob.top5)}">${x.rob.top5.toFixed(0)}%</td>${['capital','capitalQuality','momentum','durability','scarcity','income','aiResilience','valueCapture','entrepreneurship','defensibility','accessibility','proofability'].map(k=>`<td class="n heat ${heat(s(n,k))}">${s(n,k).toFixed(0)}</td>`).join('')}<td class="n heat ${heat(s(n,'crowdingR